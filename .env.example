# Default: a fully local synthetic workspace. No provider is claimed.
PORT=4310
HOST=127.0.0.1
DATA_DIR=./data
COOKIE_SECURE=false

# Optional OpenAI-compatible Gemma endpoint, e.g. a self-hosted vLLM /v1/ URL.
# Set both URL and exact model name to enable. Errors fail closed, without fallback.
GEMMA_BASE_URL=
GEMMA_MODEL=
GEMMA_API_KEY=
GEMMA_STRUCTURED_OUTPUTS=false

# Optional ElevenLabs. Recordings are processed in memory, never saved by VOX.
ELEVENLABS_API_KEY=
ELEVENLABS_STT_MODEL=scribe_v2
ELEVENLABS_VOICE_ID=
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2

# In a public HTTPS deployment:
# HOST=0.0.0.0
# COOKIE_SECURE=true
# PUBLIC_ORIGIN=https://your-deployment.example
# Use a persistent disk for DATA_DIR. One instance only for the local engine.
